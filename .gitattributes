# Auto-detect text files and normalize to LF
* text=auto

# Rust source
*.rs text eol=lf
*.toml text eol=lf

# DiscordScript source
*.ds text eol=lf

# Shell scripts
*.sh text eol=lf

# PowerShell scripts
*.ps1 text eol=lf

# Documentation
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files (never normalize)
*.png binary
*.jpg binary
*.svg binary
*.woff2 binary
*.ico binary

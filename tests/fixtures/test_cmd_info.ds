cmd info {
    slash true
    description "Informações do bot"
    embed {
        title "Informações"
        desc "Bot desenvolvido em DiscordScript"
        color "#5865F2"
        field "Versão" "1.0.0" inline true
        field "Servidores" "10" inline true
        field "Comandos" "15" inline true
        footer "DiscordScript"
        timestamp true
    }
}
